# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# GrizzlySMS API key (grizzlysms.com → Settings)
GRIZZLY_API_KEY=

# Your Telegram numeric user IDs (comma separated). Get yours from @userinfobot.
# These accounts receive notifications and can use /admin in the bot.
ADMIN_TELEGRAM_IDS=

# Web admin panel (open http://SERVER_IP:8080 )
ADMIN_PANEL_PORT=8080
ADMIN_PANEL_PASSWORD=change-this-to-a-long-password

# SQLite database file (keep this folder backed up)
DATABASE_PATH=./data/bot.sqlite

# Gmail that receives FamApp payment emails — this is what makes deposits automatic.
# App Password: Google Account → Security → 2-Step Verification → App passwords.
# Turn on IMAP in Gmail: Settings → Forwarding and POP/IMAP → Enable IMAP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_POLL_SECONDS=15

# Only emails DKIM-verified from these domains count as payments. FamApp uses famapp.in.
FAMPAY_SENDER_DOMAINS=famapp.in
GMAIL_REQUIRE_DKIM=true

# Telegram username (without @) shown on Support buttons
SUPPORT_USERNAME=OverrMaxx
