# ============================================================
#  AI Telegram Bot Hosting Platform — Environment Config
#  এই ফাইল কপি করে ".env" নাম দিন এবং মান বসান।
#  ".env" ফাইল কখনো git-এ commit করবেন না।
# ============================================================

# --- Telegram Bot (BotFather থেকে) ---
BOT_TOKEN=123456:ABC-your-bot-token-here

# --- Telegram API (https://my.telegram.org থেকে) ---
API_ID=1234567
API_HASH=your_api_hash_here

# --- আপনার Telegram ID (admin হিসেবে কাজ করবে) ---
OWNER_ID=123456789

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=bot_hosting

# --- Redis (FSM state + Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Secret encryption key (env variable encrypt করার জন্য) ---
# নিচের কমান্ড দিয়ে একটা key বানান:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=paste_generated_fernet_key_here

# --- Anthropic Claude (AI debugging) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- GitHub OAuth App (পরে Phase 6-এ লাগবে) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
